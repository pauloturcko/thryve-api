# Database Connection (either DATABASE_URL or individual DB_* vars)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/thryve
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=thryve
DB_SSL=false

# Authentication
JWT_SECRET=change-me

# CORS Configuration (comma-separated list of allowed origins, or * for all)
# Produção: https://thryve.pauloturcko.dev (sem barra no final, sem espaço após a vírgula)
CLIENT_URL=http://localhost:3000

# Cadastro de usuários (POST /users/register exige o header x-registration-key com este valor).
# Sem valor, o cadastro fica fechado para todo mundo.
REGISTRATION_KEY=

# Open Finance (Pluggy). Credenciais em https://dashboard.pluggy.ai → Applications.
# Nunca commitar os valores reais: ficam só no .env local e nas variáveis do Railway.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Webhooks do Pluggy (POST /open-finance/webhooks/pluggy).
# Segredo de assinatura (whsec_...): dashboard do Pluggy → Webhooks. Na troca de segredo, informe os dois
# separados por vírgula até a troca terminar. Sem ele, a rota recusa todos os eventos.
PLUGGY_WEBHOOK_SECRET=
# Opcional: URL pública (HTTPS) enviada no Connect Token. Alternativa a cadastrar a URL no dashboard.
# Produção: https://apithryve.pauloturcko.dev/open-finance/webhooks/pluggy
PLUGGY_WEBHOOK_URL=
